[Unit]
Description=DAM VLM annotation worker (MIMO)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/users/qiuyiwu/aha-art/pipeline/scripts
ExecStart=/bin/bash /home/ubuntu/users/qiuyiwu/aha-art/pipeline/scripts/vlm_worker.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
